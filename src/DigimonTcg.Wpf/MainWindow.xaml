<Window x:Class="DigimonTcg.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DIGIMON TCG : DIGITAL COLOSSEUM (실전 AI 대련 · 덱 빌딩 · 솔리테어 연습)"
        Icon="pack://application:,,,/Assets/DigimonTcg.ico"
        Height="960" Width="1640"
        MinHeight="800" MinWidth="1280"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        PreviewMouseMove="Window_PreviewMouseMove"
        PreviewMouseLeftButtonUp="Window_PreviewMouseLeftButtonUp"
        Background="{StaticResource Neo.Brush.Void}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ==================== [ROW 0] 상단 글로벌 네비게이션 헤더 ==================== -->
        <Border x:Name="TopHeaderBar" Grid.Row="0" BorderBrush="{StaticResource Duel.Brush.GoldEdge}" BorderThickness="0,0,0,1" Padding="16,7">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FF161D33" Offset="0"/>
                    <GradientStop Color="#FF0A0E1A" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Button x:Name="BtnNavHome" Content="🏠 로비" Click="BtnNavHome_Click" Style="{StaticResource Neo.Button.Ghost}"
                            FontWeight="ExtraBold" FontSize="12" Padding="12,5" Margin="0,0,14,0"/>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="DIGIMON" FontFamily="Arial Black" FontWeight="Black" FontSize="19" Foreground="{StaticResource Duel.Brush.LogoFill}" Margin="0,-3,0,-4">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="#000000" ShadowDepth="2" Direction="300" BlurRadius="0" Opacity="0.9"/>
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock Text="CARD GAME" FontFamily="Arial" FontWeight="Bold" FontSize="8.5" Foreground="White" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="DIGITAL COLOSSEUM" Foreground="{StaticResource Duel.Brush.Gold}" FontFamily="{StaticResource Neo.Font.Mono}" FontSize="15" FontWeight="ExtraBold" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <TextBlock x:Name="TxtCurrentModeSubtitle" Text="🏠 메인 로비 — 플레이할 모드를 선택하세요" Foreground="{StaticResource Neo.Brush.Text.Muted}" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
                <!-- 모드 전환은 로비(타이틀 화면) 세로 메뉴에서만 한다. 다른 화면에서는 [🏠 로비]로 돌아간다. -->
            </DockPanel>
        </Border>

        <!-- ==================== [ROW 1] 실시간 ActionValidator 가이드 & 토스트 피드백 배너 ==================== -->
        <Border x:Name="ToastBanner" Grid.Row="1" Background="#E60E1729" BorderBrush="#6638BDF8" BorderThickness="0,0,0,1" Padding="18,5">
            <DockPanel>
                <TextBlock x:Name="ToastBadge" Text="💡 가이드" Foreground="{StaticResource Neo.Brush.Cyan}" FontWeight="ExtraBold" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBlock x:Name="ToastMessageText"
                           Text="디지몬 TCG 디지털 콜로세움에 오신 것을 환영합니다! [실전 대련(AI)], [덱 빌딩], [연습 모드] 중 원하는 메뉴를 선택하세요."
                           Foreground="{StaticResource Neo.Brush.Text.Primary}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </DockPanel>
        </Border>

        <!-- ==================== [ROW 2] 메인 컨텐츠 컨테이너 ==================== -->
        <Grid Grid.Row="2" Margin="12,8,12,8">

            <!-- ======================================================================================== -->
            <!-- 🏠 VIEW 0: 메인 로비 = 게임 타이틀 화면 (전면 키 아트 + 로고 + 세로 메뉴 3개)          -->
            <!--    로비에서는 상단 헤더 / 안내 바를 숨긴다 (UpdateTopTabVisuals)                          -->
            <!-- ======================================================================================== -->
            <Grid x:Name="MainLobbyView" Visibility="Visible" Panel.ZIndex="10" Margin="-12,-8,-12,-8" ClipToBounds="True">
                <!-- 1) 키 아트: 흐린 배경 + 선명한 메인 일러스트 (ApplyLobbyArtwork) -->
                <Rectangle x:Name="LobbyHeroBlur" Fill="#0A0F1E" Margin="-60">
                    <Rectangle.Effect>
                        <BlurEffect Radius="40" KernelType="Gaussian"/>
                    </Rectangle.Effect>
                </Rectangle>
                <Rectangle x:Name="LobbyHeroArt" HorizontalAlignment="Right" Width="1150" Margin="0,0,-40,0">
                    <Rectangle.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                            <GradientStop Color="#00000000" Offset="0"/>
                            <GradientStop Color="#FF000000" Offset="0.38"/>
                            <GradientStop Color="#FF000000" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.OpacityMask>
                </Rectangle>
                <!-- 왼쪽 메뉴가 읽히도록 어둡게 + 아래쪽 비네트 -->
                <Border IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                            <GradientStop Color="#F205070D" Offset="0"/>
                            <GradientStop Color="#C005070D" Offset="0.32"/>
                            <GradientStop Color="#2005070D" Offset="0.62"/>
                            <GradientStop Color="#4005070D" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Border IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                            <GradientStop Color="#00000000" Offset="0.6"/>
                            <GradientStop Color="#CC000000" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- 2) 로고 + 세로 메뉴 -->
                <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center" Margin="110,0,0,40">
                    <TextBlock Text="DIGIMON" FontFamily="Arial Black" FontWeight="Black" FontSize="86" Foreground="{StaticResource Duel.Brush.LogoFill}">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#000000" ShadowDepth="5" Direction="300" BlurRadius="0" Opacity="0.9"/>
                        </TextBlock.Effect>
                    </TextBlock>
                    <TextBlock Text="CARD GAME" FontFamily="Arial" FontWeight="Bold" FontSize="26" Foreground="White" Margin="6,-10,0,0"/>
                    <TextBlock Text="DIGITAL COLOSSEUM" FontFamily="{StaticResource Neo.Font.Mono}" FontWeight="ExtraBold" FontSize="22" Foreground="{StaticResource Duel.Brush.Gold}" Margin="6,6,0,64"/>

                    <Button Content="⚔️ 실전 대련 [AI]" Click="BtnTabOfficialMatch_Click" Style="{StaticResource Lobby.MenuButton}" BorderBrush="{StaticResource Neo.Brush.Card.Red}" Margin="0,0,0,14"/>
                    <Button Content="🛠️ 덱 빌딩 &amp; 도감" Click="BtnTabDeckBuilder_Click" Style="{StaticResource Lobby.MenuButton}" BorderBrush="{StaticResource Neo.Brush.Card.Blue}" Margin="0,0,0,14"/>
                    <Button Content="🎯 연습 [솔리테어]" Click="BtnTabSimulator_Click" Style="{StaticResource Lobby.MenuButton}" BorderBrush="{StaticResource Neo.Brush.Card.Green}"/>
                </StackPanel>

                <!-- 3) 하단: 출전 덱 / 버전 -->
                <DockPanel VerticalAlignment="Bottom" Margin="116,0,32,24" IsHitTestVisible="False">
                    <TextBlock x:Name="TxtAppVersion" Text="v0.0.0" DockPanel.Dock="Right" Style="{StaticResource Duel.ZoneLabel}" ToolTip="앱 버전 (빌드한 커밋)"/>
                    <TextBlock x:Name="TxtLobbyActiveDeckName" Text="" Foreground="{StaticResource Neo.Brush.Text.Muted}" FontSize="12" VerticalAlignment="Center"/>
                </DockPanel>
            </Grid>


            <!-- ======================================================================================== -->
            <!-- ⚔️ VIEW 1 & 2 컨테이너: 좌측(실전 플레이매트 또는 덱빌더) + 우측(카드 효과 & DP/테이머 증가치 & 로그) -->
            <!-- ======================================================================================== -->
            <Grid x:Name="WorkspaceContainerGrid" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 좌측 메인 영역 (플레이매트 뷰 / 덱 빌더 뷰) -->
                <Grid x:Name="WorkspaceMainArea" Grid.Column="1" Margin="0,0,10,0">

                    <!-- ==================== [DUEL FIELD] 디지몬 카드 게임 공식 플레이매트 배치 대련장 ==================== -->
                    <!--  공식 플레이매트 (내 쪽 기준)
                          ┌ SECURITY ─────┬──────── BATTLE AREA ────────┬ DECK  ┐
                          │               │                              │       │
                          ├ DIGI-EGG ┬ BREEDING AREA ┤ (TAMER)          ├ TRASH ┤
                          └──────────┴───────────────┴───────────────────┴───────┘
                          상대 매트는 180° 회전된 거울 배치 (상대 덱·트래시 = 화면 좌측, 상대 시큐리티 = 화면 우측)
                          두 매트 사이 = 공용 메모리 게이지 (10 … 1 · 0 · 1 … 10) -->
                    <Grid x:Name="SimulatorView" Visibility="Visible">
                        <Border CornerRadius="16" Background="{StaticResource Duel.Brush.Arena}" IsHitTestVisible="False"/>

                        <Grid Margin="10,6,10,6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- ==================== [ROW 0] 상대 플레이트 & 상대 손패 ==================== -->
                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                                    <StackPanel x:Name="SoloStageButtonsPanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2">
                                        <Button x:Name="BtnStage1" Content="🐣 Stage 1" ToolTip="5턴 솔리테어 타임어택" Click="BtnStage1_Click" FontWeight="Bold" FontSize="10.5" Padding="8,3" Margin="0,0,4,0" BorderThickness="0"/>
                                        <Button x:Name="BtnStage2" Content="🛡️ Stage 2" ToolTip="블로커 돌파 챌린지" Click="BtnStage2_Click" FontWeight="Bold" FontSize="10.5" Padding="8,3" Margin="0,0,4,0" BorderThickness="0"/>
                                        <Button x:Name="BtnStage3" Content="⚔️ Stage 3: AI 대전" Click="BtnStage3_Click" Visibility="Collapsed" FontWeight="ExtraBold" FontSize="10.5" Padding="8,3" BorderThickness="0"/>
                                    </StackPanel>
                                    <StackPanel x:Name="MatchOpponentPanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2">
                                        <ComboBox x:Name="CmbMatchOpponentDeck" Width="190" FontSize="11" Margin="0,0,4,0" ToolTip="상대 AI 덱 선택" SelectionChanged="CmbOpponentDeck_SelectionChanged"/>
                                        <Button Content="🔄 재대전" Click="BtnRematchAi_Click" Style="{StaticResource Neo.Button.Danger}" FontSize="10.5" Padding="9,3"/>
                                    </StackPanel>
                                </WrapPanel>

                                <StackPanel x:Name="OppHandBacksPanel" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="12,0"/>

                                <Border Grid.Column="2" Style="{StaticResource Duel.Plate}" HorizontalAlignment="Right" BorderBrush="{StaticResource Neo.Brush.Rose.Soft}">
                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock x:Name="TxtOppPlateName" Text="OPPONENT" Foreground="{StaticResource Neo.Brush.Text.Primary}" FontWeight="ExtraBold" FontSize="11.5" HorizontalAlignment="Right" MaxWidth="220" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock x:Name="TxtOppPlateInfo" Text="HAND 5 · DECK 39 · TRASH 0" Foreground="{StaticResource Neo.Brush.Text.Muted}" FontFamily="{StaticResource Neo.Font.Mono}" FontSize="10" HorizontalAlignment="Right"/>
                                        </StackPanel>
                                        <Grid Width="38" Height="38" Margin="0,0,10,0">
                                            <Ellipse Fill="#2A0F1A" Stroke="{StaticResource Neo.Brush.Rose}" StrokeThickness="2" Effect="{StaticResource Neo.Glow.Rose.Soft}"/>
                                            <TextBlock Text="AI" Foreground="{StaticResource Neo.Brush.RoseSoft}" FontFamily="{StaticResource Neo.Font.Mono}" FontWeight="ExtraBold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="SECURITY" Style="{StaticResource Duel.ZoneLabel}" Foreground="{StaticResource Neo.Brush.RoseSoft}"/>
                                            <TextBlock x:Name="TxtOppPlateSecurity" Text="5" Style="{StaticResource Duel.PlateNumber}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- ==================== [ROW 1] 상대 플레이매트 (180° 거울 배치) ==================== -->
                            <Grid Grid.Row="1" Height="232">
                                <Border Style="{StaticResource Duel.Mat.Opponent}" IsHitTestVisible="False"/>
                                <Border CornerRadius="18" Background="{StaticResource Duel.Brush.MatPattern}" IsHitTestVisible="False"/>
                                <Grid Margin="10,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="232"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 상대 TRASH(위) / DECK(아래) : 거울 배치라 화면 좌측 -->
                                    <Grid Grid.Column="0" Margin="0,0,8,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0" Style="{StaticResource Duel.Zone.Opponent}" Margin="0,0,0,6">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Top" Text="TRASH" Style="{StaticResource Duel.ZoneLabel}" HorizontalAlignment="Center"/>
                                                <TextBlock x:Name="TxtOppTrashCount" Text="0" Foreground="{StaticResource Neo.Brush.Text.Primary}" FontFamily="{StaticResource Neo.Font.Mono}" FontWeight="ExtraBold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </Border>
                                        <Border Grid.Row="1" Style="{StaticResource Duel.Zone.Opponent}">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Top" Text="DECK" Style="{StaticResource Duel.ZoneLabel}" HorizontalAlignment="Center"/>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Border Width="28" Height="39" CornerRadius="3" Background="{StaticResource Duel.Brush.CardBackArt}" BorderBrush="{StaticResource Neo.Brush.Rose.Soft}" BorderThickness="1" Margin="0,0,6,0"/>
                                                    <TextBlock x:Name="TxtOppDeckCount" Text="39" Foreground="{StaticResource Neo.Brush.Text.Primary}" FontFamily="{StaticResource Neo.Font.Mono}" FontWeight="ExtraBold" FontSize="16" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </Grid>

                                    <!-- 상대 BATTLE AREA -->
                                    <Border x:Name="OpponentBattleAreaBorder" Grid.Column="1" Visibility="Visible" Style="{StaticResource Duel.Zone.Opponent}" Margin="0,0,8,0">
                                        <DockPanel>
                                            <DockPanel DockPanel.Dock="Bottom" Margin="0,4,0,0">
                                                <TextBlock Text="BATTLE AREA" Style="{StaticResource Duel.ZoneLabel}" Margin="0,0,10,0"/>
                                                <TextBlock x:Name="TxtOpponentZonesSummary" DockPanel.Dock="Right" Text="상대 필드: 0마리" Foreground="{StaticResource Neo.Brush.Text.Dim}" FontSize="10" VerticalAlignment="Center" Margin="10,0,0,0" Visibility="Collapsed"/>
                                                <TextBlock x:Name="TxtOpponentFieldHeader" Text="👾 상대 배틀 에어리어" Foreground="{StaticResource Neo.Brush.RoseSoft}" FontWeight="Bold" FontSize="10.5" VerticalAlignment="Center" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>
                                            <ScrollViewer x:Name="OpponentBattleAreaScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" SizeChanged="FieldScroll_SizeChanged">
                                                <Canvas x:Name="OpponentBattleAreaPanel" HorizontalAlignment="Left" VerticalAlignment="Top" MinHeight="92"/>
                                            </ScrollViewer>
                                        </DockPanel>
                                    </Border>

                                    <!-- 상대 BREEDING AREA (거울 배치: 내 육성 존의 맞은편) -->
                                    <Border Grid.Column="2" Style="{StaticResource Duel.Zone.Opponent}" BorderBrush="{StaticResource Neo.Brush.Green.Soft}" Padding="6" Margin="0,0,8,0" Width="118">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Top" Text="BREEDING" Style="{StaticResource Duel.ZoneLabel}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                            <ContentControl x:Name="OppBreedingSlot" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </Border>

                                    <!-- 상대 SECURITY : 거울 배치라 화면 우측, 세로로 쌓인 시큐리티 스택 -->
                                    <Border x:Name="OpponentSecurityZoneBorder" Grid.Column="3" Style="{StaticResource Duel.Zone.Opponent}">
                                        <DockPanel>
                                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,3">
                                                <Button x:Name="BtnToggleSecurityPeek" DockPanel.Dock="Right" Content="🙈 OFF" Click="BtnToggleSecurityPeek_Click" ToolTip="시큐리티 앞면 미리보기 (연습용)"
                                                        Style="{StaticResource Neo.Button.Ghost}" FontWeight="Bold" FontSize="9.5" Padding="6,1"/>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="SECURITY" Style="{StaticResource Duel.ZoneLabel}" Margin="0,0,6,0"/>
                                                    <TextBlock x:Name="TxtSecurityProgressLabel" Text="0/5 돌파" Foreground="{StaticResource Neo.Brush.Gold}" FontWeight="Bold" FontSize="10" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </DockPanel>
                                            <ProgressBar x:Name="BarSecurityProgress" DockPanel.Dock="Top" Style="{StaticResource Neo.ProgressBar}" Height="4" Minimum="0" Maximum="5" Value="0" Foreground="{StaticResource Neo.Brush.Green}" Margin="0,0,0,3"/>
                                            <TextBlock x:Name="TxtNextSecurityTarget" DockPanel.Dock="Top" Text="🎯 다음 시큐리티: -" Foreground="{StaticResource Neo.Brush.CyanBright}" FontWeight="Bold" FontSize="10" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock x:Name="TxtLastSecurityBattle" DockPanel.Dock="Top" Text="배틀 대기 중" Foreground="{StaticResource Neo.Brush.Text.Muted}" FontSize="9.5" TextTrimming="CharacterEllipsis" Margin="0,0,0,4"/>
                                            <ScrollViewer x:Name="OpponentSecurityScrollViewer" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                                <StackPanel x:Name="OpponentSecurityPanel" Orientation="Vertical"/>
                                            </ScrollViewer>
                                        </DockPanel>
                                    </Border>
                                </Grid>
                            </Grid>

                            <!-- ==================== [ROW 2] 공용 메모리 게이지 (두 매트 사이) ==================== -->
                            <Grid Grid.Row="2" Margin="0,4">
                                <Border Background="{StaticResource Duel.Brush.DuelBand}" IsHitTestVisible="False"/>
                                <Grid Margin="4,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Style="{StaticResource Duel.Plate}" Padding="10,3" Margin="0,0,8,0" Effect="{x:Null}">
                                            <TextBlock x:Name="TxtTurnBadge" Text="TURN 1" Foreground="{StaticResource Duel.Brush.Gold}" FontFamily="{StaticResource Neo.Font.Mono}" FontWeight="ExtraBold" FontSize="12"/>
                                        </Border>
                                        <StackPanel x:Name="PhaseStepPanel" Orientation="Horizontal" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- MEMORY : 공식 매트처럼 숫자 원형 칸 (+10 … 0 … -10), 현재 값은 슬라이딩 메모리 마커 -->
                                    <Grid Grid.Column="1" Margin="12,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="ME" Foreground="{StaticResource Neo.Brush.Cyan}" FontFamily="{StaticResource Neo.Font.Mono}" FontWeight="ExtraBold" FontSize="10.5" VerticalAlignment="Center" Margin="0,0,6,0"/>

                                        <Grid x:Name="MemoryCoreHost" Grid.Column="1" Height="34" SizeChanged="MemoryCoreHost_SizeChanged">
                                            <Border Height="4" CornerRadius="2" Background="{StaticResource Neo.Brush.MemoryCore}" VerticalAlignment="Center" Opacity="0.7"/>
                                            <UniformGrid x:Name="MemoryGaugeGrid" Rows="1" Columns="21"/>
                                            <UniformGrid x:Name="MemoryGaugeLabels" Rows="1" Columns="21" Visibility="Collapsed"/>
                                            <Canvas x:Name="MemoryCoreCanvas" IsHitTestVisible="False">
                                                <Grid x:Name="MemoryCoreIndicator" Width="34" Height="34" Canvas.Left="0" Canvas.Top="0">
                                                    <Grid.RenderTransform>
                                                        <TranslateTransform x:Name="MemoryCoreShift" X="0"/>
                                                    </Grid.RenderTransform>
                                                    <Ellipse x:Name="MemoryCoreHalo" Fill="{StaticResource Neo.Brush.Cyan}" Opacity="0.3">
                                                        <Ellipse.Triggers>
                                                            <EventTrigger RoutedEvent="Loaded">
                                                                <BeginStoryboard>
                                                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.12" To="0.5" Duration="0:0:0.9"/>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </EventTrigger>
                                                        </Ellipse.Triggers>
                                                    </Ellipse>
                                                    <Ellipse x:Name="MemoryCoreOrb" Width="28" Height="28" Fill="{StaticResource Neo.Brush.Button.Cyan}" Stroke="#CCFFFFFF" StrokeThickness="1.5"
                                                             Effect="{StaticResource Neo.Glow.Cyan}"/>
                                                    <TextBlock x:Name="TxtMemoryCoreValue" Text="0" Foreground="{StaticResource Neo.Brush.Text.OnNeon}" FontFamily="{StaticResource Neo.Font.Mono}"
                                                               FontWeight="ExtraBold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Canvas>
                                        </Grid>

                                        <TextBlock Grid.Column="2" Text="AI" Foreground="{StaticResource Neo.Brush.RoseSoft}" FontFamily="{StaticResource Neo.Font.Mono}" FontWeight="ExtraBold" FontSize="10.5" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                    </Grid>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtMemoryStatus" Text="메모리 +3" Foreground="{StaticResource Neo.Brush.Text.Muted}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0" Visibility="Collapsed"/>
                                        <Button Content="TURN END" Click="BtnPassTurn_Click" ToolTip="🛑 턴 종료 (Pass)"
                                                Style="{StaticResource Neo.Button.Primary}" FontFamily="{StaticResource Neo.Font.Mono}" FontSize="12" Padding="16,7"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>

                            <!-- ==================== [ROW 3] 내 플레이매트 (공식 배치) ==================== -->
                            <Grid Grid.Row="3">
                                <Border Style="{StaticResource Duel.Mat.Player}" IsHitTestVisible="False"/>
                                <Border CornerRadius="18" Background="{StaticResource Duel.Brush.MatPattern}" IsHitTestVisible="False"/>
                                <Grid Margin="10,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- [좌] SECURITY (위) / DIGI-EGG DECK + BREEDING AREA (아래) -->
                                    <Grid Grid.Column="0" Margin="0,0,8,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="78"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Row="0" Grid.ColumnSpan="2" Style="{StaticResource Duel.Zone}" Margin="0,0,0,6">
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,4">
                                                    <TextBlock Text="SECURITY" Style="{StaticResource Duel.ZoneLabel}"/>
                                                    <TextBlock x:Name="TxtMySecurityCountBadge" Text="5 / 5장" Foreground="{StaticResource Neo.Brush.Gold}" FontFamily="{StaticResource Neo.Font.Mono}" FontWeight="ExtraBold" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </DockPanel>
                                                <UniformGrid x:Name="MySecurityVisualStack" Rows="1" Columns="5" Height="34" Margin="0,0,0,3"/>
                                                <TextBlock x:Name="TxtMySecurityLastEvent" Text="덱 맨 위 5장 무작위 배치됨" Foreground="{StaticResource Neo.Brush.Text.Muted}" FontSize="9.5" TextTrimming="CharacterEllipsis" MaxWidth="240"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- DIGI-EGG DECK -->
                                        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Duel.Zone}" BorderBrush="{StaticResource Neo.Brush.Green.Soft}" Padding="5,6" Margin="0,0,6,0">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="DIGI-EGG" Style="{StaticResource Duel.ZoneLabel}" FontSize="9" HorizontalAlignment="Center"/>
                                                <TextBlock Text="DECK" Style="{StaticResource Duel.ZoneLabel}" FontSize="9" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                                <Border Width="44" Height="62" CornerRadius="4" HorizontalAlignment="Center" Background="{StaticResource Duel.Brush.EggBackArt}" BorderBrush="{StaticResource Neo.Brush.Green.Soft}" BorderThickness="1"/>
                                                <TextBlock x:Name="TxtDigitamaCount" Text="4장" Foreground="{StaticResource Neo.Brush.Text.Primary}" FontFamily="{StaticResource Neo.Font.Mono}" FontWeight="ExtraBold" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,6"/>
                                                <Button x:Name="BtnHatch" Content="부화" Click="BtnHatch_Click" ToolTip="🥚 디지타마 부화 (Lv.2)"
                                                        Background="{StaticResource Neo.Brush.Green}" Foreground="{StaticResource Neo.Brush.Text.OnNeon}" FontWeight="ExtraBold" FontSize="10.5" Padding="2,3" BorderThickness="0"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- BREEDING AREA -->
                                        <Border x:Name="BreedingAreaZoneBorder" Grid.Row="1" Grid.Column="1" Style="{StaticResource Duel.Zone}" BorderBrush="{StaticResource Neo.Brush.Green.Soft}" Padding="6">
                                            <DockPanel>
                                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,3">
                                                    <Button x:Name="BtnMoveBreeding" DockPanel.Dock="Right" Content="🚀 이동" Click="BtnMoveBreeding_Click" ToolTip="육성 디지몬을 배틀 에어리어로 이동"
                                                            Background="{StaticResource Neo.Brush.Button.Cyan}" Foreground="{StaticResource Neo.Brush.Text.OnNeon}" FontWeight="ExtraBold" FontSize="10" Padding="7,1" BorderThickness="0"/>
                                                    <TextBlock Text="BREEDING AREA" Style="{StaticResource Duel.ZoneLabel}"/>
                                                </DockPanel>
                                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                    <ContentControl x:Name="BreedingSlotControl" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </ScrollViewer>
                                            </DockPanel>
                                        </Border>
                                    </Grid>

                                    <!-- [중앙] BATTLE AREA + 테이머 -->
                                    <Border x:Name="BattleAreaZoneBorder" Grid.Column="1" Style="{StaticResource Duel.Zone}" Padding="10,6" Margin="0,0,8,0">
                                        <DockPanel>
                                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                                                <TextBlock Text="BATTLE AREA" Style="{StaticResource Duel.ZoneLabel}" Margin="0,0,12,0"/>
                                                <Button x:Name="BtnAutoArrangeField" DockPanel.Dock="Right" Content="▦ 자동 정렬" Click="BtnAutoArrangeField_Click"
                                                        ToolTip="끌어서 옮긴 카드 위치를 모두 지우고 격자로 다시 놓습니다 (디지몬은 왼쪽부터, 테이머는 오른쪽 끝부터)"
                                                        Style="{StaticResource Neo.Button.Ghost}" FontWeight="Bold" FontSize="10" Padding="8,1" Margin="8,0,0,0"/>
                                                <Button x:Name="BtnCancelPendingAction" DockPanel.Dock="Right" Content="❌ 선택 취소" Click="BtnCancelPendingAction_Click" Visibility="Collapsed"
                                                        Style="{StaticResource Neo.Button.Danger}" FontSize="10.5" Padding="8,2" Margin="8,0,0,0"/>
                                                <TextBlock x:Name="TxtSelectedTarget" Text="" Foreground="{StaticResource Neo.Brush.Gold}" FontWeight="Bold" FontSize="10.5" VerticalAlignment="Center" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>

                                            <Border x:Name="TamerStripBorder" DockPanel.Dock="Bottom" Style="{StaticResource Duel.Zone}" BorderBrush="{StaticResource Duel.Brush.ZoneEdge.Neutral}" CornerRadius="8" Padding="8,3" Margin="0,6,0,0">
                                                <DockPanel>
                                                    <TextBlock Text="OPTION · UNDER TAMER" Style="{StaticResource Duel.ZoneLabel}" Margin="0,0,10,0"/>
                                                    <TextBlock x:Name="TxtPlayerZonesSummary" DockPanel.Dock="Right" Text="" Visibility="Collapsed"/>
                                                    <StackPanel x:Name="TamerZonePanel" Orientation="Horizontal" VerticalAlignment="Center"/>
                                                </DockPanel>
                                            </Border>

                                            <ScrollViewer x:Name="BattleAreaScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" SizeChanged="FieldScroll_SizeChanged">
                                                <Canvas x:Name="BattleAreaPanel" HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent"/>
                                            </ScrollViewer>
                                        </DockPanel>
                                    </Border>

                                    <!-- [우] DECK (위) / TRASH (아래) -->
                                    <Grid Grid.Column="2">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0" Style="{StaticResource Duel.Zone}" Margin="0,0,0,6">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Top" Text="DECK" Style="{StaticResource Duel.ZoneLabel}" HorizontalAlignment="Center"/>
                                                <Grid Width="64" Height="86" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Border CornerRadius="6" Background="#0F172A" Effect="{StaticResource Neo.Glow.Cyan.Soft}" IsHitTestVisible="False"/>
                                                    <Border CornerRadius="6" BorderBrush="{StaticResource Neo.Brush.Cyan}" BorderThickness="1.5" Margin="3,-3,-3,3" Opacity="0.35" IsHitTestVisible="False"/>
                                                    <Border CornerRadius="6" Background="{StaticResource Duel.Brush.CardBackArt}" BorderBrush="{StaticResource Neo.Brush.Cyan}" BorderThickness="1.5">
                                                        <Border Background="#D9050A18" CornerRadius="8" Padding="6,1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,4">
                                                            <TextBlock x:Name="TxtMainDeckVisualCount" Text="40장" Foreground="{StaticResource Neo.Brush.Text.Primary}" FontFamily="{StaticResource Neo.Font.Mono}" FontWeight="ExtraBold" FontSize="11"/>
                                                        </Border>
                                                    </Border>
                                                </Grid>
                                            </DockPanel>
                                        </Border>
                                        <Border x:Name="PlayerTrashZoneBorder" Grid.Row="1" Style="{StaticResource Duel.Zone}" MouseRightButtonUp="PlayerTrashZone_MouseRightButtonUp">
                                            <DockPanel>
                                                <DockPanel DockPanel.Dock="Top">
                                                    <TextBlock Text="TRASH" Style="{StaticResource Duel.ZoneLabel}"/>
                                                    <TextBlock x:Name="TxtTrashVisualCount" Text="0장" Foreground="{StaticResource Neo.Brush.Gold}" FontFamily="{StaticResource Neo.Font.Mono}" FontWeight="ExtraBold" FontSize="10.5" HorizontalAlignment="Right"/>
                                                </DockPanel>
                                                <Viewbox StretchDirection="DownOnly">
                                                    <ContentControl x:Name="TrashTopCardControl" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Viewbox>
                                            </DockPanel>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Grid>

                            <!-- ==================== [ROW 4] 내 플레이트 · 손패 ==================== -->
                            <!-- 손패는 내 매트 아래쪽 가장자리를 살짝 덮고 올라온다 -->
                            <Grid Grid.Row="4" Margin="0,-30,0,0" Panel.ZIndex="5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Bottom" Margin="0,0,10,4">
                                    <Border Style="{StaticResource Duel.Plate}" BorderBrush="{StaticResource Neo.Brush.Cyan.Soft}" Margin="0,0,0,6">
                                        <StackPanel Orientation="Horizontal">
                                            <Grid Width="40" Height="40" Margin="0,0,8,0">
                                                <Ellipse Fill="#0B2234" Stroke="{StaticResource Neo.Brush.Cyan}" StrokeThickness="2" Effect="{StaticResource Neo.Glow.Cyan.Soft}"/>
                                                <TextBlock Text="YOU" Foreground="{StaticResource Neo.Brush.CyanBright}" FontFamily="{StaticResource Neo.Font.Mono}" FontWeight="ExtraBold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                            <StackPanel VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="SECURITY" Style="{StaticResource Duel.ZoneLabel}" Foreground="{StaticResource Neo.Brush.Cyan}" Margin="0,0,8,0"/>
                                                    <TextBlock x:Name="TxtPlayerPlateSecurity" Text="5" Style="{StaticResource Duel.PlateNumber}"/>
                                                </StackPanel>
                                                <TextBlock x:Name="TxtPlayerPlateInfo" Text="DECK 40 · TRASH 0 · EGG 4" Foreground="{StaticResource Neo.Brush.Text.Muted}" FontFamily="{StaticResource Neo.Font.Mono}" FontSize="10"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <UniformGrid Rows="1" Columns="2">
                                        <Button x:Name="BtnPassBreeding" Content="⏭️ 육성 패스" Click="BtnPassBreeding_Click" Style="{StaticResource Neo.Button.Gold}" FontSize="10.5" Padding="6,4" Margin="0,0,3,0"/>
                                        <Button x:Name="BtnMulligan" Content="🔄 멀리건" Click="BtnMulligan_Click" ToolTip="손패 5장을 덱에 되돌리고 다시 뽑습니다 (1회)"
                                                Style="{StaticResource Neo.Button.Ghost}" FontWeight="Bold" FontSize="10.5" Padding="6,4" Margin="3,0,0,0"/>
                                    </UniformGrid>
                                </StackPanel>

                                <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="0,14,0,0">
                                    <StackPanel x:Name="HandPanel" Orientation="Horizontal" HorizontalAlignment="Center"/>
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                    </Grid>

                    <!-- ==================== [DECK BUILDER] 카드 바인더 앨범 (좌) + 덱 서랍 (우) ==================== -->
                    <Grid x:Name="DeckBuilderView" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="400"/>
                        </Grid.ColumnDefinitions>

                        <!-- 좌측: 카드 바인더 (가죽 커버 + 스티치 + 바인더 링) -->
                        <Grid Grid.Column="0" Margin="0,0,10,0">
                            <Border CornerRadius="16" Background="{StaticResource Duel.Brush.Binder}" BorderBrush="{StaticResource Duel.Brush.ZoneEdge.Neutral}" BorderThickness="1" Effect="{StaticResource Neo.Shadow.Float}" IsHitTestVisible="False"/>
                            <Rectangle Margin="7" RadiusX="12" RadiusY="12" Stroke="#55E8C77A" StrokeThickness="1.2" StrokeDashArray="5 4" IsHitTestVisible="False"/>
                            <!-- 바인더 링 -->
                            <UniformGrid Rows="4" Columns="1" HorizontalAlignment="Left" Width="22" Margin="10,40" IsHitTestVisible="False">
                                <Ellipse Width="14" Height="14" Stroke="{StaticResource Duel.Brush.GoldEdge}" StrokeThickness="2.5" Fill="#05070D"/>
                                <Ellipse Width="14" Height="14" Stroke="{StaticResource Duel.Brush.GoldEdge}" StrokeThickness="2.5" Fill="#05070D"/>
                                <Ellipse Width="14" Height="14" Stroke="{StaticResource Duel.Brush.GoldEdge}" StrokeThickness="2.5" Fill="#05070D"/>
                                <Ellipse Width="14" Height="14" Stroke="{StaticResource Duel.Brush.GoldEdge}" StrokeThickness="2.5" Fill="#05070D"/>
                            </UniformGrid>

                            <DockPanel Margin="40,16,16,14">
                                <!-- 검색 / 필터 -->
                                <WrapPanel DockPanel.Dock="Top" VerticalAlignment="Center" Margin="0,0,0,8">
                                    <TextBlock Text="🔍" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBox x:Name="TxtSearchKeyword" Width="180" Margin="0,0,14,0" ToolTip="카드 이름 / 번호 검색" TextChanged="FilterChanged"/>

                                    <TextBlock Text="COLOR" Style="{StaticResource Duel.ZoneLabel}" Margin="0,0,6,0"/>
                                    <ComboBox x:Name="CmbFilterColor" Width="92" Margin="0,0,12,0" SelectionChanged="FilterChanged" SelectedIndex="0">
                                        <ComboBoxItem Content="전체"/>
                                        <ComboBoxItem Content="레드" Tag="Red"/>
                                        <ComboBoxItem Content="블루" Tag="Blue"/>
                                        <ComboBoxItem Content="옐로" Tag="Yellow"/>
                                        <ComboBoxItem Content="그린" Tag="Green"/>
                                        <ComboBoxItem Content="블랙" Tag="Black"/>
                                        <ComboBoxItem Content="퍼플" Tag="Purple"/>
                                        <ComboBoxItem Content="화이트" Tag="White"/>
                                    </ComboBox>

                                    <TextBlock Text="TYPE" Style="{StaticResource Duel.ZoneLabel}" Margin="0,0,6,0"/>
                                    <ComboBox x:Name="CmbFilterType" Width="100" Margin="0,0,12,0" SelectionChanged="FilterChanged" SelectedIndex="0">
                                        <ComboBoxItem Content="전체"/>
                                        <ComboBoxItem Content="디지타마" Tag="Digitama"/>
                                        <ComboBoxItem Content="디지몬" Tag="Digimon"/>
                                        <ComboBoxItem Content="테이머" Tag="Tamer"/>
                                        <ComboBoxItem Content="옵션" Tag="Option"/>
                                    </ComboBox>

                                    <TextBlock Text="LEVEL" Style="{StaticResource Duel.ZoneLabel}" Margin="0,0,6,0"/>
                                    <ComboBox x:Name="CmbFilterLevel" Width="78" Margin="0,0,14,0" SelectionChanged="FilterChanged" SelectedIndex="0">
                                        <ComboBoxItem Content="전체"/>
                                        <ComboBoxItem Content="Lv.2"/>
                                        <ComboBoxItem Content="Lv.3"/>
                                        <ComboBoxItem Content="Lv.4"/>
                                        <ComboBoxItem Content="Lv.5"/>
                                        <ComboBoxItem Content="Lv.6"/>
                                        <ComboBoxItem Content="Lv.7"/>
                                    </ComboBox>

                                    <TextBlock Text="SET" Style="{StaticResource Duel.ZoneLabel}" Margin="0,0,6,0"/>
                                    <ComboBox x:Name="CmbFilterSet" Width="88" Margin="0,0,12,0" SelectionChanged="FilterChanged"/>

                                    <TextBlock Text="RARITY" Style="{StaticResource Duel.ZoneLabel}" Margin="0,0,6,0"/>
                                    <ComboBox x:Name="CmbFilterRarity" Width="96" Margin="0,0,12,0" SelectionChanged="FilterChanged" SelectedIndex="0"
                                              ToolTip="C 커먼 · U 언커먼 · R 레어 · SR 슈퍼 레어 · SEC 시크릿 레어 · P 프로모">
                                        <ComboBoxItem Content="전체"/>
                                        <ComboBoxItem Content="C"/>
                                        <ComboBoxItem Content="U"/>
                                        <ComboBoxItem Content="R"/>
                                        <ComboBoxItem Content="SR"/>
                                        <ComboBoxItem Content="SEC"/>
                                        <ComboBoxItem Content="P"/>
                                    </ComboBox>

                                    <TextBlock Text="EFFECT" Style="{StaticResource Duel.ZoneLabel}" Margin="0,0,6,0"/>
                                    <ComboBox x:Name="CmbFilterImpl" Width="110" Margin="0,0,14,0" SelectionChanged="FilterChanged" SelectedIndex="0"
                                              ToolTip="전부 동작 = 대전에서 효과 문장이 모두 동작 (효과 없는 카드 포함) / 일부 동작 = 동작하지 않는 절이 있음 / 미지원 = 효과가 동작하지 않음 (DP · 코스트 · 진화 조건만)">
                                        <ComboBoxItem Content="전체"/>
                                        <ComboBoxItem Content="전부 동작"/>
                                        <ComboBoxItem Content="일부 동작"/>
                                        <ComboBoxItem Content="미지원"/>
                                    </ComboBox>

                                    <Button x:Name="BtnSyncApi" Content="🌐 전체 카드 업데이트" Click="BtnSyncApi_Click" Style="{StaticResource Neo.Button.Ghost}" FontWeight="Bold" FontSize="11" Padding="10,4"
                                            ToolTip="DigimonCard.io에서 전 세트 카드(약 4,500장)를 받아 도감에 추가합니다"/>
                                </WrapPanel>

                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                    <TextBlock Text="클릭 = 덱에 넣기 · 우클릭 = 빼기" DockPanel.Dock="Right" Style="{StaticResource Duel.ZoneLabel}" Foreground="{StaticResource Neo.Brush.Gold}"/>
                                    <TextBlock x:Name="TxtCatalogCount" Text="카드 도감 목록" Foreground="{StaticResource Neo.Brush.Text.Muted}" FontWeight="Bold" FontSize="11.5" VerticalAlignment="Center"/>
                                </DockPanel>

                                <!-- 바인더 페이지 넘김 (카드가 수천 장이라 한 페이지씩 그린다) -->
                                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                                    <Button x:Name="BtnCatalogPrev" Content="◀ 이전" Click="BtnCatalogPrev_Click" Style="{StaticResource Neo.Button.Ghost}" FontSize="11" Padding="12,3" Margin="0,0,10,0"/>
                                    <TextBlock x:Name="TxtCatalogPage" Text="1 / 1" Foreground="{StaticResource Neo.Brush.Gold}" FontFamily="{StaticResource Neo.Font.Mono}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <Button x:Name="BtnCatalogNext" Content="다음 ▶" Click="BtnCatalogNext_Click" Style="{StaticResource Neo.Button.Ghost}" FontSize="11" Padding="12,3"/>
                                </StackPanel>

                                <ScrollViewer x:Name="CatalogScrollViewer" VerticalScrollBarVisibility="Auto">
                                    <WrapPanel x:Name="CatalogWrapPanel" Orientation="Horizontal"/>
                                </ScrollViewer>
                            </DockPanel>
                        </Grid>

                        <!-- 우측: 덱 서랍 (프리셋 · 저장/불러오기 · 황금 비율 · 현재 덱) -->
                        <Border Grid.Column="1" Style="{StaticResource Duel.SidePanel}" CornerRadius="16" Padding="14,12" Margin="0">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                    <TextBlock Text="🗂️ 덱 서랍" Style="{StaticResource Duel.SidePanelTitle}" FontSize="14" Foreground="{StaticResource Duel.Brush.Gold}"/>
                                    <TextBlock Text="추천 메타 덱 (원클릭 50장)" Style="{StaticResource Duel.ZoneLabel}" Margin="0,0,0,5"/>
                                    <UniformGrid Rows="3" Columns="2" Margin="0,0,0,8">
                                        <Button Content="🔥 레드: 워그레이·오메가" Click="BtnLoadPresetSt1_Click" Style="{StaticResource Neo.Button.Chip}" Background="{StaticResource Neo.Brush.Card.Red}" Padding="6,5" Margin="0,0,3,4"/>
                                        <Button Content="❄️ 블루: 메탈가루·오메가" Click="BtnLoadPresetSt2_Click" Style="{StaticResource Neo.Button.Chip}" Background="{StaticResource Neo.Brush.Card.Blue}" Padding="6,5" Margin="3,0,0,4"/>
                                        <Button Content="⚡ 옐로: 세라피몬" Click="BtnLoadPresetSt3_Click" Style="{StaticResource Neo.Button.Chip}" Background="{StaticResource Neo.Brush.Card.Yellow}" Padding="6,5" Margin="0,0,3,4"/>
                                        <Button Content="🌿 그린: 헤라클레스" Click="BtnLoadPresetSt4_Click" Style="{StaticResource Neo.Button.Chip}" Background="{StaticResource Neo.Brush.Card.Green}" Padding="6,5" Margin="3,0,0,4"/>
                                        <Button Content="⚙️ 블랙: 파워드라몬" Click="BtnLoadPresetSt5_Click" Style="{StaticResource Neo.Button.Chip}" Background="{StaticResource Neo.Brush.Card.Black}" Padding="6,5" Margin="0,0,3,4"/>
                                        <Button Content="💜 퍼플: 피에몬" Click="BtnLoadPresetSt6_Click" Style="{StaticResource Neo.Button.Chip}" Background="{StaticResource Neo.Brush.Card.Purple}" Padding="6,5" Margin="3,0,0,4"/>
                                    </UniformGrid>

                                    <Button x:Name="BtnAutoCompleteDeck" Content="🤖 AI 추천 덱 자동 완성 (넣은 카드 기반 50장)" Click="BtnAutoCompleteDeck_Click"
                                            Style="{StaticResource Neo.Button.Primary}" FontSize="11.5" Padding="8,7" Margin="0,0,0,6"/>

                                    <UniformGrid Rows="1" Columns="4">
                                        <Button Content="💾 저장" Click="BtnSaveCustomDeck_Click" Style="{StaticResource Neo.Button.Ghost}" FontWeight="Bold" FontSize="11" Padding="4,5" Margin="0,0,3,0"/>
                                        <Button Content="📂 불러오기" Click="BtnLoadCustomDeck_Click" Style="{StaticResource Neo.Button.Ghost}" FontWeight="Bold" FontSize="11" Padding="4,5" Margin="0,0,3,0"/>
                                        <Button Content="🗑️ 비우기" Click="BtnClearDeck_Click" Style="{StaticResource Neo.Button.Ghost}" FontWeight="Bold" FontSize="11" Padding="4,5" Margin="0,0,3,0"/>
                                        <Button Content="⚔️ 대련!" Click="BtnPlayWithCurrentDeck_Click" Style="{StaticResource Neo.Button.Gold}" FontSize="11" Padding="4,5"/>
                                    </UniformGrid>
                                </StackPanel>

                                <Border DockPanel.Dock="Top" Style="{StaticResource Neo.Panel.Inset}" Padding="10,8" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="📊 황금 비율 (초심자 권장)" Foreground="{StaticResource Neo.Brush.CyanBright}" FontWeight="Bold" FontSize="12" Margin="0,0,0,4"/>
                                        <StackPanel x:Name="GoldenRatioHudPanel"/>
                                        <TextBlock x:Name="TxtDeckValidationStatus" Text="✅ 덱 검증 통과" Foreground="{StaticResource Neo.Brush.Green}" FontWeight="Bold" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="TxtDeckEffectSupport" Text=" " FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"
                                                   ToolTip="이 덱의 카드 효과가 대전에서 얼마나 동작하는지 (⚠ 표시 카드는 덱 목록에서 확인)"/>
                                    </StackPanel>
                                </Border>

                                <DockPanel>
                                    <TextBlock x:Name="TxtDeckListHeader" DockPanel.Dock="Top" Text="📋 현재 덱 구성" Foreground="{StaticResource Neo.Brush.Text.Secondary}" FontWeight="Bold" FontSize="12" Margin="0,0,0,5"/>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel x:Name="CurrentDeckListPanel"/>
                                    </ScrollViewer>
                                </DockPanel>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ==================== [INSPECTOR] 우측 카드 설명 사이드바 (덱 빌더 · 실전 · 연습 공통) ==================== -->
                <Grid x:Name="InspectorSidebar" Grid.Column="2" Width="350">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="InspectorSidebarShift" X="0"/>
                    </Grid.RenderTransform>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 1) 카드 디자인 & 효과 상세 프리뷰 -->
                    <Border x:Name="InspectorCardSection" Grid.Row="0" Background="{StaticResource Neo.Brush.Popup}" CornerRadius="12" BorderBrush="#F9E2AF" BorderThickness="1.5" Padding="10" Margin="0,0,0,6">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,5">
                                <TextBlock x:Name="TxtInspectorTitle" Text="🔍 카드 효과 &amp; 상세 프리뷰" Foreground="#F9E2AF" FontWeight="ExtraBold" FontSize="13"/>
                                <TextBlock x:Name="TxtInspectorId" Text="ST1-11" Foreground="#A6ADC8" FontWeight="Bold" FontSize="11.5" HorizontalAlignment="Right"/>
                            </DockPanel>

                            <Grid x:Name="InspectorCardGrid">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="InspectorImageColumn" Width="136"/>
                                    <ColumnDefinition x:Name="InspectorTextColumn" Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- 좌측: 실물 TCG 카드 이미지 프레임 -->
                                <Border x:Name="InspectorCardFrame" Grid.Column="0" Width="130" Height="182" CornerRadius="8"
                                        BorderBrush="#F38BA8" BorderThickness="2" Background="#11111B" HorizontalAlignment="Left" ClipToBounds="True">
                                    <Grid>
                                        <Image x:Name="ImgInspectorCard" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <Border x:Name="InspectorFallbackPanel" Background="#1E1E2E" Visibility="Collapsed" Padding="8">
                                            <TextBlock x:Name="TxtInspectorFallback" Foreground="#F8FAFC" FontWeight="Bold" TextAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- 우측: 한글 카드 스탯 & 효과 설명 -->
                                <StackPanel x:Name="InspectorTextPanel" Grid.Column="1" Margin="8,0,0,0">
                                    <Border x:Name="InspectorColorBadge" Background="#F38BA8" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" Margin="0,0,0,3">
                                        <TextBlock x:Name="TxtInspectorBadge" Text="Lv.6 Red Digimon" Foreground="#11111B" FontWeight="Bold" FontSize="10.5"/>
                                    </Border>
                                    <TextBlock x:Name="TxtInspectorName" Text="워그레이몬" Foreground="#F8FAFC" FontWeight="ExtraBold" FontSize="15.5" TextWrapping="Wrap" Margin="0,0,0,3"/>
                                    <Border x:Name="InspectorImplNote" Background="#33FAB387" BorderBrush="#99FAB387" BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="0,0,0,5" Visibility="Collapsed">
                                        <TextBlock x:Name="TxtInspectorImplNote" Text="⚠️ 효과 미구현" Foreground="#FAB387" FontWeight="Bold" FontSize="10.5" TextWrapping="Wrap"/>
                                    </Border>
                                    <TextBlock x:Name="TxtInspectorStats" Text="등장: 12 | 진화: 4 (Lv.5)&#x0a;기본 DP: 12000" Foreground="#89DCEB" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,5"/>

                                    <Border Background="#0E111B" CornerRadius="4" Padding="6" Margin="0,0,0,4">
                                        <StackPanel>
                                            <TextBlock Text="[메인 효과]" Foreground="#F9E2AF" FontWeight="Bold" FontSize="10"/>
                                            <TextBlock x:Name="TxtInspectorEffect" Text="-" Foreground="#CDD6F4" FontSize="10.5" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="#0E111B" CornerRadius="4" Padding="6">
                                        <StackPanel>
                                            <TextBlock Text="[진화원 효과]" Foreground="#A6E3A1" FontWeight="Bold" FontSize="10"/>
                                            <TextBlock x:Name="TxtInspectorInherited" Text="-" Foreground="#CDD6F4" FontSize="10.5" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 2) 📊 필드 카드 호버/클릭 시 활성화되는 [DP 증가치 · 테이머 효과 · 진화원 스택] 상세 인스펙터 -->
                    <Border x:Name="FieldStatBreakdownBorder" Grid.Row="1" Background="{StaticResource Neo.Brush.Popup}" CornerRadius="12" BorderBrush="#A6E3A1" BorderThickness="1.5" Padding="10,8" Margin="0,0,0,6">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,4">
                                <TextBlock x:Name="TxtFieldInspectHeader" Text="📊 필드 디지몬 DP &amp; 테이머 증가치 확인" Foreground="#A6E3A1" FontWeight="ExtraBold" FontSize="12.5"/>
                                <TextBlock x:Name="TxtFieldInspectPinState" Text="(필드 카드에 마우스 오버/클릭)" Foreground="#89DCEB" FontWeight="Bold" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </DockPanel>

                            <Border Background="#0D1418" CornerRadius="6" Padding="8,6" BorderBrush="#263B40" BorderThickness="1">
                                <StackPanel x:Name="FieldStatBreakdownPanel">
                                    <TextBlock x:Name="TxtFieldDpBreakdown" Text="⚔️ 총 DP: 필드의 디지몬에 마우스를 올리거나 클릭하면 기본 DP + 진화원 + 테이머 + 옵션 증가치가 여기에 표시됩니다."
                                               Foreground="#F8FAFC" FontWeight="Bold" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,3"/>
                                    <TextBlock x:Name="TxtFieldSecBreakdown" Text="💥 시큐리티 타격: -"
                                               Foreground="#F9E2AF" FontWeight="SemiBold" FontSize="10.5" TextWrapping="Wrap" Margin="0,0,0,3"/>
                                    <TextBlock x:Name="TxtFieldTamerAndSources" Text="🧬 진화원 &amp; 테이머 효과: -"
                                               Foreground="#89DCEB" FontSize="10.5" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- 3) 대전 현황 & 평가 지표 HUD -->
                    <Border x:Name="InspectorHudSection" Grid.Row="2" Visibility="Collapsed" Background="{StaticResource Neo.Brush.Popup}" CornerRadius="12" BorderBrush="#CBA6F7" BorderThickness="1" Padding="9,7" Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock Text="⏱️ 전장 현황 &amp; 진화 체인 지표" Foreground="#CBA6F7" FontWeight="Bold" FontSize="12" Margin="0,0,0,4"/>
                            <Border Background="#0E111B" CornerRadius="5" Padding="7,5" Margin="0,0,0,4">
                                <StackPanel>
                                    <TextBlock x:Name="TxtHudTurn" Text="• 현재 진행 턴: 1턴" Foreground="#89DCEB" FontSize="11" Margin="0,1"/>
                                    <TextBlock x:Name="TxtHudSecurity" Text="• 상대 시큐리티: 5장 | 내 시큐리티: 5장" Foreground="#F38BA8" FontSize="11" Margin="0,1"/>
                                    <TextBlock x:Name="TxtHudEvoRate" Text="• 진화 체인 성공률 (Lv.3→Lv.6): 0.0% (0/0)" Foreground="#A6E3A1" FontSize="11" Margin="0,1"/>
                                    <TextBlock x:Name="TxtHudMemoryEff" Text="• 턴당 메모리 사용 효율: 0.0 메모리/턴" Foreground="#F9E2AF" FontSize="11" Margin="0,1"/>
                                </StackPanel>
                            </Border>
                            <TextBlock x:Name="TxtGameResultBanner" Text="진행 중: 육성/진화로 승리 플랜을 완성하세요!" Foreground="#CDD6F4" FontWeight="Bold" FontSize="11" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- 4) 실시간 게임 & 룰 엔진 로그 -->
                    <Border x:Name="InspectorLogSection" Grid.Row="3" Background="{StaticResource Neo.Brush.Popup}" CornerRadius="12" BorderBrush="#313244" BorderThickness="1" Padding="9,7">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="📜 실시간 배틀 &amp; 카드 효과 로그" Foreground="#89B4FA" FontWeight="ExtraBold" FontSize="12.5" Margin="0,0,0,5"/>
                            <ListBox x:Name="LstActionLogs" Background="#0E111B" Foreground="#CDD6F4" BorderThickness="0" FontSize="11"/>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- ==================== 👑 [SPECIAL OVERLAY] 궁극체(Lv.6) & 초궁극체(Lv.7) 강림 포효 컷인 ==================== -->
        <!--  data/cutins/{카드번호 또는 디지몬 이름}.mp4|.wmv 가 있으면 영상 재생, 없으면 카드 일러스트로 포효 연출
              (줌 펀치 · 카메라 흔들림 · 회전 집중선 · 충격파 · 플래시) — 화면 클릭 시 즉시 닫힘 -->
        <Grid x:Name="UltimateCutInOverlay" Grid.Row="0" Grid.RowSpan="3" Panel.ZIndex="950" ClipToBounds="True"
              Visibility="Collapsed" Background="#F2020308" MouseLeftButtonDown="UltimateCutInOverlay_MouseLeftButtonDown">

            <!-- 1) 카드 색상 오라 -->
            <Border x:Name="CutInAura" IsHitTestVisible="False"/>

            <!-- 2) 회전 집중선 (가운데는 비워 둔다) -->
            <Rectangle x:Name="CutInSpeedLines" Width="2800" Height="2800" HorizontalAlignment="Center" VerticalAlignment="Center"
                       RenderTransformOrigin="0.5,0.5" Opacity="0.4" IsHitTestVisible="False">
                <Rectangle.RenderTransform>
                    <RotateTransform x:Name="CutInSpeedLinesRotate" Angle="0"/>
                </Rectangle.RenderTransform>
                <Rectangle.OpacityMask>
                    <RadialGradientBrush>
                        <GradientStop Color="#00000000" Offset="0"/>
                        <GradientStop Color="#00000000" Offset="0.12"/>
                        <GradientStop Color="#FF000000" Offset="0.45"/>
                    </RadialGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>

            <!-- 3) 포효하는 디지몬 (일러스트 또는 영상) : 줌 펀치 + 흔들림 -->
            <Grid x:Name="CutInArtHost" Width="900" Height="520" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,120"
                  RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                <Grid.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="CutInArtScale" ScaleX="1" ScaleY="1"/>
                        <TranslateTransform x:Name="CutInShake" X="0" Y="0"/>
                    </TransformGroup>
                </Grid.RenderTransform>
                <Grid.OpacityMask>
                    <RadialGradientBrush RadiusX="0.56" RadiusY="0.6">
                        <GradientStop Color="#FF000000" Offset="0.55"/>
                        <GradientStop Color="#00000000" Offset="1"/>
                    </RadialGradientBrush>
                </Grid.OpacityMask>
                <Rectangle x:Name="CutInArt"/>
                <MediaElement x:Name="CutInVideo" LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="UniformToFill" Visibility="Collapsed"
                              MediaEnded="CutInVideo_MediaEnded" MediaFailed="CutInVideo_MediaFailed"/>
            </Grid>

            <!-- 4) 충격파 -->
            <Ellipse x:Name="CutInShockwave1" Width="260" Height="260" Stroke="White" StrokeThickness="6" Opacity="0" Margin="0,0,0,120" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform><ScaleTransform/></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="CutInShockwave2" Width="260" Height="260" Stroke="White" StrokeThickness="4" Opacity="0" Margin="0,0,0,120" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform><ScaleTransform/></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="CutInShockwave3" Width="260" Height="260" Stroke="White" StrokeThickness="3" Opacity="0" Margin="0,0,0,120" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform><ScaleTransform/></Ellipse.RenderTransform>
            </Ellipse>

            <!-- 5) 포효 효과음 문자 -->
            <TextBlock x:Name="TxtCutInRoar" Text="크아아아앙!!" FontSize="92" FontWeight="Black" FontStyle="Italic" Foreground="White"
                       HorizontalAlignment="Left" VerticalAlignment="Top" Margin="140,90,0,0" Opacity="0" IsHitTestVisible="False" RenderTransformOrigin="0.3,0.5">
                <TextBlock.RenderTransform>
                    <TransformGroup>
                        <SkewTransform AngleX="-12"/>
                        <RotateTransform Angle="-8"/>
                        <ScaleTransform x:Name="CutInRoarScale" ScaleX="1" ScaleY="1"/>
                    </TransformGroup>
                </TextBlock.RenderTransform>
            </TextBlock>

            <!-- 6) 이름 · 등급 · 스탯 -->
            <StackPanel x:Name="CutInTextPanel" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,56" IsHitTestVisible="False">
                <StackPanel.RenderTransform>
                    <TranslateTransform x:Name="CutInTextShift" X="0"/>
                </StackPanel.RenderTransform>
                <Border x:Name="UltimateCutInBanner" BorderThickness="0,2,0,2" Padding="40,4" HorizontalAlignment="Center" Margin="0,0,0,8">
                    <TextBlock x:Name="TxtUltimateCutInTier" Text="👑 ULTIMATE EVOLUTION · 궁극체 강림!" FontFamily="{StaticResource Neo.Font.Mono}" FontWeight="ExtraBold" FontSize="16" HorizontalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="TxtUltimateCutInName" Text="워그레이몬" Foreground="White" FontWeight="Black" FontSize="60" HorizontalAlignment="Center" Effect="{StaticResource Neo.Glow.Gold}"/>
                <TextBlock x:Name="TxtUltimateCutInStats" Text="⚔️ 15,000 DP | 💥 시큐리티 3장" Foreground="{StaticResource Neo.Brush.Green}" FontWeight="ExtraBold" FontSize="20" HorizontalAlignment="Center" Margin="0,4,0,8"/>
                <TextBlock x:Name="TxtUltimateCutInEffect" Text="-" Foreground="{StaticResource Neo.Brush.Text.Secondary}" FontSize="13.5" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="900" HorizontalAlignment="Center"/>
                <TextBlock Text="(화면을 클릭하면 바로 닫힙니다)" Foreground="{StaticResource Neo.Brush.Text.Dim}" FontSize="11" HorizontalAlignment="Center" Margin="0,8,0,0"/>
            </StackPanel>

            <!-- 7) 화면 플래시 -->
            <Border x:Name="CutInFlash" Background="White" Opacity="0" IsHitTestVisible="False"/>
        </Grid>

        <!-- ==================== 🤖 [OPPONENT REPLAY] 상대 턴 행동을 한 장면씩 다시 보여 주기 ==================== -->
        <!--  클릭 = 다음 장면, [모두 건너뛰기] = 리플레이 종료. 장면 데이터는 GameState.OpponentTurnEvents -->
        <Grid x:Name="OpponentReplayOverlay" Grid.Row="0" Grid.RowSpan="3" Panel.ZIndex="940" Visibility="Collapsed" Background="#80000000"
              MouseLeftButtonDown="OpponentReplayOverlay_MouseLeftButtonDown">
            <Border x:Name="ReplayBand" VerticalAlignment="Center" Height="330" BorderThickness="0,2,0,2" BorderBrush="{StaticResource Neo.Brush.Rose.Soft}">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                        <GradientStop Color="#00140A18" Offset="0"/>
                        <GradientStop Color="#F2140A18" Offset="0.18"/>
                        <GradientStop Color="#F2140A18" Offset="0.82"/>
                        <GradientStop Color="#00140A18" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <StackPanel x:Name="ReplayContent" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel.RenderTransform>
                            <TranslateTransform x:Name="ReplayContentShift" X="0"/>
                        </StackPanel.RenderTransform>
                        <!-- 왼쪽: 상대 턴 라벨 + 진행 -->
                        <StackPanel VerticalAlignment="Center" Margin="0,0,34,0" Width="150">
                            <Grid Width="56" Height="56" HorizontalAlignment="Left" Margin="0,0,0,8">
                                <Ellipse Fill="#2A0F1A" Stroke="{StaticResource Neo.Brush.Rose}" StrokeThickness="2" Effect="{StaticResource Neo.Glow.Rose.Soft}"/>
                                <TextBlock Text="AI" Foreground="{StaticResource Neo.Brush.RoseSoft}" FontFamily="{StaticResource Neo.Font.Mono}" FontWeight="ExtraBold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="OPPONENT TURN" Foreground="{StaticResource Neo.Brush.RoseSoft}" FontFamily="{StaticResource Neo.Font.Mono}" FontWeight="ExtraBold" FontSize="13"/>
                            <TextBlock x:Name="TxtReplayStep" Text="1 / 5" Foreground="{StaticResource Neo.Brush.Text.Muted}" FontFamily="{StaticResource Neo.Font.Mono}" FontSize="12" Margin="0,4,0,0"/>
                        </StackPanel>
                        <!-- 가운데: 행동한 카드 (→ 대상 카드) -->
                        <ContentControl x:Name="ReplayCardSlot" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtReplayArrow" Text="▶" Foreground="{StaticResource Neo.Brush.Gold}" FontSize="34" VerticalAlignment="Center" Margin="18,0"/>
                        <ContentControl x:Name="ReplaySubCardSlot" VerticalAlignment="Center"/>
                        <!-- 오른쪽: 행동 설명 -->
                        <StackPanel VerticalAlignment="Center" Margin="36,0,0,0" MaxWidth="560">
                            <Border x:Name="ReplayKindChip" Style="{StaticResource Neo.Chip}" Margin="0,0,0,10">
                                <TextBlock x:Name="TxtReplayKind" Text="ATTACK" FontFamily="{StaticResource Neo.Font.Mono}" FontWeight="ExtraBold" FontSize="12"/>
                            </Border>
                            <TextBlock x:Name="TxtReplayTitle" Text="공격 선언" Foreground="White" FontWeight="Black" FontSize="38"/>
                            <TextBlock x:Name="TxtReplayDetail" Text="-" Foreground="{StaticResource Neo.Brush.Text.Secondary}" FontSize="16" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <Button x:Name="BtnReplaySkip" Content="모두 건너뛰기 ▶▶" Click="BtnReplaySkip_Click" Style="{StaticResource Neo.Button.Ghost}"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,40,14" FontSize="11.5" Padding="12,4"/>
                    <TextBlock Text="클릭하면 다음 장면" Style="{StaticResource Duel.ZoneLabel}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="40,0,0,18"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== 💾 [DECK SAVE] 덱 이름을 정해 저장 (같은 이름이면 덮어쓰기 확인) ==================== -->
        <Grid x:Name="DeckSaveOverlay" Grid.Row="0" Grid.RowSpan="3" Panel.ZIndex="948" Visibility="Collapsed" Background="#B3000000"
              MouseLeftButtonDown="DeckOverlayBackdrop_MouseLeftButtonDown">
            <Border Width="460" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24,20" CornerRadius="10"
                    Background="{StaticResource Neo.Brush.SurfaceRaised}" BorderBrush="{StaticResource Neo.Brush.Cyan}" BorderThickness="1.5"
                    MouseLeftButtonDown="DeckOverlayPanel_MouseLeftButtonDown">
                <StackPanel>
                    <TextBlock Text="덱 저장" Foreground="White" FontWeight="Black" FontSize="22"/>
                    <TextBlock x:Name="TxtDeckSaveSummary" Text="-" Foreground="{StaticResource Neo.Brush.Text.Secondary}" FontSize="12.5" TextWrapping="Wrap" Margin="0,4,0,14"/>
                    <TextBlock Text="덱 이름" Foreground="{StaticResource Neo.Brush.Text.Muted}" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtDeckSaveName" FontSize="14" Padding="8,6" TextChanged="TxtDeckSaveName_TextChanged" KeyDown="TxtDeckSaveName_KeyDown"/>
                    <TextBlock x:Name="TxtDeckSaveHint" Text=" " FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Content="취소" Click="BtnDeckSaveCancel_Click" Style="{StaticResource Neo.Button.Ghost}" FontWeight="Bold" Padding="16,7" Margin="0,0,8,0"/>
                        <Button x:Name="BtnDeckSaveConfirm" Content="저장" Click="BtnDeckSaveConfirm_Click" Style="{StaticResource Neo.Button.Primary}" FontWeight="Bold" Padding="20,7"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ==================== 📂 [DECK LOAD] 저장한 덱 목록에서 불러오기 / 삭제 ==================== -->
        <Grid x:Name="DeckLoadOverlay" Grid.Row="0" Grid.RowSpan="3" Panel.ZIndex="948" Visibility="Collapsed" Background="#B3000000"
              MouseLeftButtonDown="DeckOverlayBackdrop_MouseLeftButtonDown">
            <Border Width="560" MaxHeight="620" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24,20" CornerRadius="10"
                    Background="{StaticResource Neo.Brush.SurfaceRaised}" BorderBrush="{StaticResource Neo.Brush.Cyan}" BorderThickness="1.5"
                    MouseLeftButtonDown="DeckOverlayPanel_MouseLeftButtonDown">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <TextBlock Text="저장한 덱" Foreground="White" FontWeight="Black" FontSize="22"/>
                        <TextBlock x:Name="TxtDeckLoadSummary" Text="-" Foreground="{StaticResource Neo.Brush.Text.Secondary}" FontSize="12.5" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button DockPanel.Dock="Bottom" Content="닫기" Click="BtnDeckLoadClose_Click" Style="{StaticResource Neo.Button.Ghost}"
                            FontWeight="Bold" Padding="16,7" HorizontalAlignment="Right" Margin="0,14,0,0"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="DeckLoadListPanel"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ==================== 🃏 [MULLIGAN] 게임 시작 전 초기 손패 확인 / 다시 뽑기 (공식 룰 5-2) ==================== -->
        <!--  손패 5장 → 멀리건 1회 → 시큐리티 5장 → 게임 시작. 엔진은 Phase.Setup에서 기다리고, [이 손패로 시작]이 BeginGame을 부른다 -->
        <Grid x:Name="MulliganOverlay" Grid.Row="0" Grid.RowSpan="3" Panel.ZIndex="942" Visibility="Collapsed" Background="#B3000000">
            <Border VerticalAlignment="Center" BorderThickness="0,2,0,2" BorderBrush="{StaticResource Neo.Brush.Cyan}" Padding="0,24">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                        <GradientStop Color="#000A1220" Offset="0"/>
                        <GradientStop Color="#F20A1220" Offset="0.14"/>
                        <GradientStop Color="#F20A1220" Offset="0.86"/>
                        <GradientStop Color="#000A1220" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel HorizontalAlignment="Center">
                    <Border Style="{StaticResource Neo.Chip}" BorderBrush="{StaticResource Neo.Brush.Cyan}" HorizontalAlignment="Center" Margin="0,0,0,10">
                        <TextBlock Text="GAME SETUP" Foreground="{StaticResource Neo.Brush.CyanBright}" FontFamily="{StaticResource Neo.Font.Mono}" FontWeight="ExtraBold" FontSize="12"/>
                    </Border>
                    <TextBlock Text="초기 손패 확인" Foreground="White" FontWeight="Black" FontSize="30" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtMulliganDetail" Text="-" Foreground="{StaticResource Neo.Brush.Text.Secondary}" FontSize="14" TextWrapping="Wrap" TextAlignment="Center"
                               HorizontalAlignment="Center" MaxWidth="760" Margin="0,6,0,16"/>
                    <StackPanel x:Name="MulliganHandPanel" Orientation="Horizontal" HorizontalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                        <Button x:Name="BtnKeepHand" Content="이 손패로 시작 ▶" Click="BtnKeepHand_Click" Style="{StaticResource Neo.Button.Primary}"
                                FontWeight="Bold" FontSize="14" Padding="22,9" Margin="0,0,12,0"/>
                        <Button x:Name="BtnRedrawHand" Content="🔄 다시 뽑기 (멀리건 1회)" Click="BtnRedrawHand_Click" Style="{StaticResource Neo.Button.Ghost}"
                                FontWeight="Bold" FontSize="14" Padding="18,9"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ==================== 🛡️ [BLOCK CHOICE] AI의 어택을 ≪블로커≫로 막을지 선택 ==================== -->
        <!--  공식 룰: 블록은 방어 측의 선택. 엔진이 GameState.PendingBlock에서 AI 턴을 멈추고, 고르면 ResolvePendingBlock으로 이어 간다 -->
        <Grid x:Name="BlockChoiceOverlay" Grid.Row="0" Grid.RowSpan="3" Panel.ZIndex="945" Visibility="Collapsed" Background="#99000000">
            <Border VerticalAlignment="Center" BorderThickness="0,2,0,2" BorderBrush="{StaticResource Neo.Brush.Green}" Padding="0,22">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                        <GradientStop Color="#000A1812" Offset="0"/>
                        <GradientStop Color="#F20A1812" Offset="0.16"/>
                        <GradientStop Color="#F20A1812" Offset="0.84"/>
                        <GradientStop Color="#000A1812" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <!-- 왼쪽: 어택해 온 AI 디지몬 -->
                    <StackPanel VerticalAlignment="Center" Margin="0,0,30,0">
                        <TextBlock Text="INCOMING ATTACK" Foreground="{StaticResource Neo.Brush.RoseSoft}" FontFamily="{StaticResource Neo.Font.Mono}" FontWeight="ExtraBold" FontSize="12" Margin="0,0,0,8"/>
                        <ContentControl x:Name="BlockAttackerSlot"/>
                    </StackPanel>
                    <!-- 오른쪽: 블로커 후보 + 블록하지 않음 -->
                    <StackPanel VerticalAlignment="Center" MaxWidth="760">
                        <Border Style="{StaticResource Neo.Chip}" BorderBrush="{StaticResource Neo.Brush.Green}" HorizontalAlignment="Left" Margin="0,0,0,10">
                            <TextBlock Text="BLOCK?" Foreground="{StaticResource Neo.Brush.Green}" FontFamily="{StaticResource Neo.Font.Mono}" FontWeight="ExtraBold" FontSize="12"/>
                        </Border>
                        <TextBlock x:Name="TxtBlockTitle" Text="블록하시겠습니까?" Foreground="White" FontWeight="Black" FontSize="30" TextWrapping="Wrap"/>
                        <TextBlock x:Name="TxtBlockDetail" Text="-" Foreground="{StaticResource Neo.Brush.Text.Secondary}" FontSize="14" TextWrapping="Wrap" Margin="0,6,0,14"/>
                        <WrapPanel x:Name="BlockCandidatesPanel" Orientation="Horizontal"/>
                        <Button x:Name="BtnNoBlock" Click="BtnNoBlock_Click" Style="{StaticResource Neo.Button.Ghost}" HorizontalAlignment="Left" Margin="0,14,0,0" Padding="16,8">
                            <StackPanel>
                                <TextBlock Text="블록하지 않음" FontWeight="Bold" FontSize="14"/>
                                <TextBlock x:Name="TxtNoBlockOutcome" Text="-" FontSize="11.5" Opacity="0.8" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ==================== 🏁 [GAME RESULT] 승리 / 패배 화면 ==================== -->
        <!--  data/cutins/victory.mp4 · defeat.mp4 (.wmv / .mov) 가 있으면 배경 영상 재생 -->
        <Grid x:Name="GameResultOverlay" Grid.Row="0" Grid.RowSpan="3" Panel.ZIndex="955" Visibility="Collapsed" Background="#EB020308" ClipToBounds="True">
            <MediaElement x:Name="ResultVideo" LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="UniformToFill" Visibility="Collapsed" IsHitTestVisible="False"
                          MediaFailed="ResultVideo_MediaFailed"/>
            <Border x:Name="ResultAura" IsHitTestVisible="False"/>
            <Rectangle x:Name="ResultRays" Width="2800" Height="2800" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.3"
                       RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                <Rectangle.RenderTransform>
                    <RotateTransform x:Name="ResultRaysRotate" Angle="0"/>
                </Rectangle.RenderTransform>
                <Rectangle.OpacityMask>
                    <RadialGradientBrush>
                        <GradientStop Color="#00000000" Offset="0"/>
                        <GradientStop Color="#00000000" Offset="0.08"/>
                        <GradientStop Color="#FF000000" Offset="0.4"/>
                    </RadialGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="TxtResultTitle" Text="VICTORY" FontFamily="Arial Black" FontWeight="Black" FontSize="128" HorizontalAlignment="Center"
                           RenderTransformOrigin="0.5,0.5" Foreground="{StaticResource Duel.Brush.LogoFill}">
                    <TextBlock.RenderTransform>
                        <ScaleTransform x:Name="ResultTitleScale" ScaleX="1" ScaleY="1"/>
                    </TextBlock.RenderTransform>
                    <TextBlock.Effect>
                        <DropShadowEffect x:Name="ResultTitleGlow" Color="#F9E2AF" ShadowDepth="0" BlurRadius="40" Opacity="0.8"/>
                    </TextBlock.Effect>
                </TextBlock>
                <TextBlock x:Name="TxtResultSub" Text="승리!" Foreground="White" FontWeight="Black" FontSize="28" HorizontalAlignment="Center" Margin="0,-6,0,18"/>
                <TextBlock x:Name="TxtResultReason" Text="-" Foreground="{StaticResource Neo.Brush.Text.Secondary}" FontSize="15" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="820" HorizontalAlignment="Center"/>
                <TextBlock x:Name="TxtResultStats" Text="-" Foreground="{StaticResource Neo.Brush.Text.Muted}" FontFamily="{StaticResource Neo.Font.Mono}" FontSize="13" HorizontalAlignment="Center" Margin="0,12,0,34"/>
                <StackPanel x:Name="ResultButtons" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="🔄 다시 하기" Click="BtnResultRetry_Click" Style="{StaticResource Neo.Button.Gold}" FontSize="15" Padding="26,10" Margin="0,0,12,0"/>
                    <Button Content="🔍 필드 보기" Click="BtnResultClose_Click" Style="{StaticResource Neo.Button.Ghost}" FontSize="15" Padding="22,10" Margin="0,0,12,0"/>
                    <Button Content="🏠 로비" Click="BtnResultLobby_Click" Style="{StaticResource Neo.Button.Ghost}" FontSize="15" Padding="22,10"/>
                </StackPanel>
            </StackPanel>
            <Border x:Name="ResultFlash" Background="White" Opacity="0" IsHitTestVisible="False"/>
        </Grid>

        <!-- ==================== [COIN TOSS] 실전 대련 시작 시 선공 / 후공 결정 ==================== -->
        <Grid x:Name="CoinTossOverlay" Grid.Row="0" Grid.RowSpan="3" Panel.ZIndex="960" Visibility="Collapsed" Background="#E6020308"
              MouseLeftButtonDown="CoinTossOverlay_MouseLeftButtonDown">
            <Border Background="{StaticResource Duel.Brush.Arena}" Opacity="0.6" IsHitTestVisible="False"/>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="COIN TOSS" Foreground="{StaticResource Duel.Brush.Gold}" FontFamily="{StaticResource Neo.Font.Mono}" FontWeight="ExtraBold" FontSize="22" HorizontalAlignment="Center"/>
                <TextBlock Text="앞면(ME) = 내가 선공 · 뒷면(AI) = 상대 선공" Foreground="{StaticResource Neo.Brush.Text.Muted}" FontSize="13" HorizontalAlignment="Center" Margin="0,6,0,40"/>

                <Grid Width="200" Height="200" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="CoinFlipScale" ScaleX="1" ScaleY="1"/>
                            <TranslateTransform x:Name="CoinLift" Y="0"/>
                        </TransformGroup>
                    </Grid.RenderTransform>
                    <Ellipse x:Name="CoinBody" StrokeThickness="8" Stroke="{StaticResource Duel.Brush.GoldEdge}" Effect="{StaticResource Neo.Glow.Gold}">
                        <Ellipse.Fill>
                            <RadialGradientBrush GradientOrigin="0.35,0.3">
                                <GradientStop Color="#FFF6D0" Offset="0"/>
                                <GradientStop Color="#E8C77A" Offset="0.55"/>
                                <GradientStop Color="#9C7428" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Ellipse Margin="20" Stroke="#99FFFFFF" StrokeThickness="2" StrokeDashArray="2 2"/>
                    <TextBlock x:Name="TxtCoinFace" Text="ME" FontFamily="Arial Black" FontWeight="Black" FontSize="58" Foreground="#0B4A7A"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <Ellipse x:Name="CoinShadow" Width="150" Height="18" Fill="#80000000" Margin="0,18,0,0" HorizontalAlignment="Center"/>

                <TextBlock x:Name="TxtCoinResult" Text="" Foreground="White" FontWeight="Black" FontSize="32" HorizontalAlignment="Center" Margin="0,26,0,0" Opacity="0"/>
                <TextBlock x:Name="TxtCoinResultSub" Text="" Foreground="{StaticResource Neo.Brush.Text.Secondary}" FontSize="13.5" HorizontalAlignment="Center" Margin="0,6,0,0" Opacity="0"/>
                <TextBlock Text="(화면을 클릭하면 바로 진행합니다)" Foreground="{StaticResource Neo.Brush.Text.Dim}" FontSize="11" HorizontalAlignment="Center" Margin="0,18,0,0"/>
            </StackPanel>
        </Grid>

        <!-- 드래그 앤 드롭 플로팅 카드 고스트 오버레이 -->
        <Canvas x:Name="DragOverlayCanvas" Grid.Row="0" Grid.RowSpan="3" Panel.ZIndex="999" IsHitTestVisible="False" Visibility="Collapsed"/>
    </Grid>
</Window>
